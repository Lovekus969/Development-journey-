<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADD POST</title>
</head>

<body>

    <form action="/posts" method="POST">

        <input
            placeholder="Enter username"
            name="username"
            type="text"
        >

        <br>

        <textarea
            placeholder="Write your post here..."
            name="Content"
        ></textarea>

        <br>

        <button type="submit">
            Submit Post
        </button>

    </form>

</body>
</html>